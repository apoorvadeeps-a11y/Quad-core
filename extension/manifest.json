{
  "manifest_version": 3,
  "name": "OneStep — AI Web Navigation Assistant",
  "version": "1.0.0",
  "description": "AI-guided browser navigation assistant that connects real webpages to your local FastAPI backend.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OneStep Assistant"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
